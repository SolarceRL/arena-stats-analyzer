{
  "name": "arena-stats-analyzer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node --loader ts-node/esm server/api.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node --loader ts-node/esm server/api.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "lucide-react": "^0.294.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.1.0",
    "vite": "^5.0.0",
    "typescript": "^5.2.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "ts-node": "^10.9.0",
    "concurrently": "^8.2.0"
  }
}
